{
  "name": "freelens-readable-logs-v2",
  "version": "0.1.36",
  "private": true,
  "description": "Readable bounded container log snapshots for Freelens 2",
  "license": "UNLICENSED",
  "main": "out/main-0.1.36.js",
  "renderer": "out/renderer-0.1.36.mjs",
  "storeName": "freelens-readable-logs-v2",
  "files": [
    "out/",
    "docs/local-development.md"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "freelens": "^2.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "node scripts/verify-find-identity.mjs",
    "test:workers": "node scripts/verify-find-execution.mjs",
    "test:smoke": "node scripts/resource-smoke.mjs",
    "build": "node scripts/build.mjs",
    "package": "npm run build && npm pack --pack-destination dist",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@fontsource/material-icons": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@freelensapp/extensions": "2.0.0",
    "@types/node": "24.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.10.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "ws": "8.22.0"
  }
}
